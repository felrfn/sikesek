# Copy to /opt/sikesek/.env on the VPS (chmod 600). This file is never
# committed. Values here are runtime values for the container; the
# NEXT_PUBLIC_* build values are supplied by GitHub Actions from the
# matching GitHub Environment (dev / prod).
#
# Domain cutover: change APP_DOMAIN and APP_URL in this file, then
# `docker compose up -d --force-recreate app caddy` (or run the deploy
# workflow). No code changes are required.

# --- Public host -----------------------------------------------------------
# Caddy reads APP_DOMAIN. APP_URL is used server-side for the Midtrans
# "finish" redirect and is read at runtime, so it can change without a rebuild.
APP_DOMAIN=aqiissh.my.id
APP_URL=https://aqiissh.my.id
NEXT_PUBLIC_APP_URL=https://aqiissh.my.id
NEXT_PUBLIC_API_URL=

# --- Container image -------------------------------------------------------
# Normally set by the deploy workflow; these defaults are for manual runs.
# APP_IMAGE=ghcr.io/felrfn/sikesek:latest
# MIGRATE_IMAGE=ghcr.io/felrfn/sikesek-migrate:latest
# APP_MEM_LIMIT=700m
# NODE_OPTIONS=--max-old-space-size=384
# TZ=Asia/Jakarta

# --- Database --------------------------------------------------------------
# Runtime uses the pooled Neon connection (host contains "-pooler").
DATABASE_URL=
# Migrations use the direct (non-pooled) Neon host. Remove "-pooler" from the
# DATABASE_URL host. Only `prisma migrate deploy` reads this.
DIRECT_URL=

# --- Auth ------------------------------------------------------------------
# Keep the same value on Vercel and the VPS so the two deployments behave
# identically. Rotating it logs everyone out.
AUTH_SECRET=
MOBILE_JWT_SECRET=

# --- Midtrans --------------------------------------------------------------
# Keep the server and browser flags in sync. Anything other than "true" is
# sandbox. NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION is baked at build time by the
# deploy workflow; the copy here documents the required value.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# --- Scheduled jobs --------------------------------------------------------
# Only needed if the VPS runs the cron endpoints itself. While Vercel Cron is
# the scheduler, both hosts still need the same value for manual calls.
CRON_SECRET=

# --- Object storage (Cloudflare R2) ----------------------------------------
# S3_ENDPOINT is the R2 API endpoint; S3_PUBLIC_URL is the Worker hostname
# that only serves public/* (deploy/r2-public-worker.js).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=sikesek-dev
S3_PUBLIC_URL=https://cdn.aqiissh.my.id
S3_FORCE_PATH_STYLE=false
# Only set when presigned URLs must use a different public S3 API hostname.
S3_PUBLIC_ENDPOINT=

# Legacy R2 names are still accepted as fallbacks, but new deployments should
# use the S3_* variables above.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# --- Email (optional) ------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- KTR fog-server --------------------------------------------------------
KTR_INGEST_API_KEY=

# --- Firebase Admin / FCM (optional) --------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
