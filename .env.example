# Public (safe to expose to the browser)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Private (server-side only, never exposed to the browser)
DATABASE_URL=

MIDTRANS_SERVER_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

AUTH_SECRET=

# Shared secret used by the YOLOv8 fog-server component to authenticate
# POST /api/ktr/detect requests (machine-to-machine, not a user session).
KTR_INGEST_API_KEY=

# Firebase Admin service account, used to send FCM push notifications to
# field officers (FR-10). Not exercised in this build without real
# credentials; ingestion still records notifications if these are unset.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
