# Public (safe to expose to the browser)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# Private (server-side only, never exposed to the browser)
DATABASE_URL=

MIDTRANS_SERVER_KEY=

# Secret for the scheduled payment-expiry endpoint
# (GET /api/cron/payments). The scheduler must send
# `Authorization: Bearer $CRON_SECRET`. The endpoint fails closed when this
# is unset. See docs/PAYMENT.md.
CRON_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

AUTH_SECRET=

# Mobile (field-officer) bearer-JWT signing secret (docs/MOBILE_API.md).
# Optional - falls back to AUTH_SECRET if unset. Set a distinct value in
# production so the two token schemes can be rotated independently.
MOBILE_JWT_SECRET=

# SMTP for booking confirmation emails (invoice + e-ticket PDF). Optional in
# development - email sending is skipped with a console warning if unset,
# the booking/payment flow itself never fails because of this.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret used by the YOLOv8 fog-server component to authenticate the
# machine-to-machine KTR endpoints (GET /api/ktr/areas,
# POST /api/ktr/evidence-url, POST /api/ktr/detect). Not a user session.
# R2 evidence upload is optional; see docs/KTR_INGEST.md.
KTR_INGEST_API_KEY=

# Firebase Admin service account, used to send FCM push notifications to
# field officers (FR-10). Not exercised in this build without real
# credentials; ingestion still records notifications if these are unset.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
