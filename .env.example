# Public (safe to expose to the browser)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=
# Server-side public URL used for the Midtrans `finish` redirect. Read at
# runtime, so changing the deployment domain does not require a rebuild.
# Falls back to NEXT_PUBLIC_APP_URL when unset.
APP_URL=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Midtrans environment for Snap.js (browser). "true" = production, anything
# else (or unset) = sandbox. Inlined at build time - set it before `next build`.
# Must match MIDTRANS_IS_PRODUCTION on the server.
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=

# Private (server-side only, never exposed to the browser)
# Runtime connection (pooled Neon host). `prisma migrate deploy` uses
# DIRECT_URL instead so it can take session locks through a direct connection.
DATABASE_URL=
DIRECT_URL=

MIDTRANS_SERVER_KEY=
# Midtrans API environment: "true" = production, anything else (or unset) =
# sandbox. Keep this in sync with NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION. Using
# sandbox credentials against the production API (or vice versa) makes Snap
# return HTTP 401 Unauthorized.
MIDTRANS_IS_PRODUCTION=

# Secret for the scheduled backend jobs (GET /api/cron/payments and
# GET /api/cron/bookings). The scheduler must send
# `Authorization: Bearer $CRON_SECRET`. Both endpoints fail closed when this
# is unset. See docs/PAYMENT.md and docs/BOOKING_REMINDERS.md.
CRON_SECRET=

# S3-compatible object storage (Cloudflare R2, AWS S3, MinIO, etc.).
# S3_ENDPOINT is optional for AWS S3 and required for R2/MinIO.
# S3_FORCE_PATH_STYLE is normally true for MinIO and false for AWS/R2.
# S3_PUBLIC_ENDPOINT is optional and only affects presigned URLs - use it when
# the app reaches storage over an internal hostname but clients need a public
# S3 API hostname (not a CloudFront/CDN domain). See docs/STORAGE.md.
# S3_PUBLIC_URL must only expose public/* (the bucket also holds private/*
# KTR evidence). For R2 use a Cloudflare Worker, not the raw bucket custom
# domain - see deploy/r2-public-worker.js.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_ENDPOINT=

# Legacy Cloudflare R2 names are still accepted as fallbacks, but new
# deployments should use the S3_* variables above:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

AUTH_SECRET=

# Mobile (field-officer) bearer-JWT signing secret (docs/MOBILE_API.md).
# Optional - falls back to AUTH_SECRET if unset. Set a distinct value in
# production so the two token schemes can be rotated independently.
MOBILE_JWT_SECRET=

# SMTP for booking confirmation emails (invoice + e-ticket PDF). Optional in
# development - email sending is skipped with a console warning if unset,
# the booking/payment flow itself never fails because of this.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret used by the YOLOv8 fog-server component to authenticate the
# machine-to-machine KTR endpoints (GET /api/ktr/areas,
# POST /api/ktr/evidence-url, POST /api/ktr/detect). Not a user session.
# R2 evidence upload is optional; see docs/KTR_INGEST.md.
KTR_INGEST_API_KEY=

# Firebase Admin service account, used to send FCM push notifications to
# field officers (FR-10). Not exercised in this build without real
# credentials; ingestion still records notifications if these are unset.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
