// SIKESEK database schema
// Derived from the example DBML in .ai/ARCHITECTURE.md (section 11),
// with two naming decisions made explicit by the product owner:
// - role uses ADMIN / FIELD_OFFICER (RULES.md, PRD.md) instead of admin/employee
// - detection status uses DETECTED / NOTIFIED / RESOLVED (RULES.md, MEMORY.md)
//   instead of open/assigned/resolved/false_positive
// The exact schema may evolve as backend implementation proceeds (PRD.md ยง11).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  FIELD_OFFICER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

// CHECKED_IN is a distinct step from COMPLETED (the visitor has arrived and
// been ticket-validated, but the stay/visit itself may still be ongoing).
// REJECTED is an admin-initiated refusal, distinct from a CANCELLED booking
// (customer/system initiated, e.g. an expired payment).
enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REJECTED
}

enum DayType {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// DETECTED: just ingested, nobody notified/looked at it yet.
// NOTIFIED: field officers have been pushed a notification (existing
// ingestion flow - unrelated to whether anyone is formally assigned).
// ASSIGNED: an admin has assigned one or more workers to resolve it.
// IN_PROGRESS: at least one assigned worker has started work.
// RESOLVED: the violation was real and has been handled.
// FALSE_POSITIVE: the AI/system flagged something that wasn't a violation.
// DISMISSED: an admin intentionally closed the case for an operational
// reason unrelated to detection accuracy - distinct from FALSE_POSITIVE.
enum DetectionStatus {
  DETECTED
  NOTIFIED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  FALSE_POSITIVE
  DISMISSED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// AVAILABLE/UNAVAILABLE are day-to-day operational status; LEAVE is a
// planned absence (vacation, personal); OFF is a scheduled non-working day
// (e.g. weekly rest day) - kept distinct so admin UI/reporting can tell
// "worker chose not to be available today" apart from "not scheduled to
// work today" apart from "on approved leave".
enum WorkerAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  LEAVE
  OFF
}

// Internal workflow status for a refund attempt, kept separate from
// Midtrans's own transaction_status string (stored verbatim in
// Refund.midtransStatus) so the two vocabularies never get conflated.
enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// Provenance of a KTR record. API is anything ingested through
// POST /api/ktr/detect (today: a manually-triggered fog-server call; later:
// an automated CCTV/YOLOv8 pipeline hitting the same endpoint - no schema
// change needed when that's wired up). MANUAL is an admin-created entry
// (e.g. backfilling an incident that a camera didn't catch).
enum DetectionSource {
  API
  MANUAL
}

// ==========================================
// USERS & KTR MONITORING
// ==========================================

model User {
  id                 String  @id @default(uuid())
  email              String  @unique
  username           String  @unique
  name               String
  hashedPassword     String  @map("hashed_password")
  // Set whenever an admin creates the account or resets its password
  // (both now assign a random password, never an admin-chosen one) -
  // cleared only by the user's own successful password change. Enforced
  // server-side in requireMobileAuth, not just a client-side UI nudge.
  mustChangePassword Boolean @default(false) @map("must_change_password")
  phone              String?
  role               Role    @default(FIELD_OFFICER)
  // R2 object key under private/ (see docs/STORAGE.md) - never a public URL.
  profileImageKey    String? @map("profile_image_key")

  createdAt  DateTime  @default(now()) @map("created_at")
  approvedAt DateTime? @map("approved_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  fcmTokens                UserFcmToken[]
  assignedAreas            MonitoredArea[]    @relation("AreaAssignedEmployee")
  assignedDetections       SmokingDetection[] @relation("DetectionAssignedTo")
  resolvedDetections       SmokingDetection[] @relation("DetectionResolvedBy")
  notifications            Notification[]
  verifiedTickets          Ticket[]           @relation("TicketVerifiedBy")
  ktrAssignmentsAsWorker   KtrAssignment[]    @relation("KtrAssignmentWorker")
  ktrAssignmentsAsAssigner KtrAssignment[]    @relation("KtrAssignmentAssigner")
  schedules                WorkerSchedule[]   @relation("WorkerScheduleWorker")
  scheduleChangesLogged    WorkerSchedule[]   @relation("WorkerScheduleChangedBy")
  auditLogs                AuditLog[]
  refundsRequested         Refund[]

  @@map("users")
}

// A worker may authenticate from multiple devices at once (Android phone,
// iPhone, tablet), so this is keyed by token, not one-token-per-user - the
// unique constraint on `token` lets registration be a plain upsert.
model UserFcmToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String?
  deviceId   String?  @map("device_id")
  deviceInfo String?  @map("device_info")
  isActive   Boolean  @default(true) @map("is_active")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_fcm_tokens")
}

model MonitoredArea {
  id                  String   @id @default(uuid())
  name                String
  locationDescription String?  @map("location_description")
  // Optional: the AI pipeline may own camera/stream configuration itself.
  // Kept here so it can be shared via GET /api/ktr/areas when desired.
  streamUrl           String?  @map("stream_url")
  assignedEmployeeId  String?  @map("assigned_employee_id")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  assignedEmployee User?              @relation("AreaAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  detections       SmokingDetection[]

  @@map("monitored_areas")
}

model SmokingDetection {
  id          String          @id @default(uuid())
  areaId      String          @map("area_id")
  confidence  Decimal         @db.Decimal(5, 4)
  // R2 object key under private/ (see docs/STORAGE.md). Evidence is never
  // exposed via a public URL - the admin UI fetches a short-lived signed URL.
  evidenceKey String          @map("evidence_key")
  source      DetectionSource @default(API)
  status      DetectionStatus @default(DETECTED)
  assignedTo  String?         @map("assigned_to")
  detectedAt  DateTime        @map("detected_at")
  resolvedBy  String?         @map("resolved_by")
  resolvedAt  DateTime?       @map("resolved_at")
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  area           MonitoredArea   @relation(fields: [areaId], references: [id])
  assignedToUser User?           @relation("DetectionAssignedTo", fields: [assignedTo], references: [id])
  resolvedByUser User?           @relation("DetectionResolvedBy", fields: [resolvedBy], references: [id])
  notifications  Notification[]
  assignments    KtrAssignment[]

  @@index([status])
  @@index([detectedAt])
  @@index([resolvedAt])
  @@map("smoking_detections")
}

// A single violation can be assigned to multiple workers at once (section 3
// of the task this was built for) without creating duplicate
// SmokingDetection rows - this join/task model is deliberately separate
// from the detection itself and from "who resolved it"
// (SmokingDetection.resolvedBy): a worker can be assigned and never be the
// one who actually resolves the case.
model KtrAssignment {
  id           String           @id @default(uuid())
  detectionId  String           @map("detection_id")
  assignedToId String           @map("assigned_to_id")
  assignedById String           @map("assigned_by_id")
  status       AssignmentStatus @default(ASSIGNED)
  note         String?
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  acceptedAt   DateTime?        @map("accepted_at")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  detection  SmokingDetection @relation(fields: [detectionId], references: [id])
  assignedTo User             @relation("KtrAssignmentWorker", fields: [assignedToId], references: [id])
  assignedBy User             @relation("KtrAssignmentAssigner", fields: [assignedById], references: [id])

  @@index([detectionId])
  @@index([assignedToId])
  @@map("ktr_assignments")
}

// One row per worker per calendar date. A missing row for a given
// worker/date is treated as AVAILABLE by default (see
// features/workers/schedule.ts) so admins only need to record exceptions,
// not every ordinary working day.
model WorkerSchedule {
  id          String                   @id @default(uuid())
  workerId    String                   @map("worker_id")
  date        DateTime                 @db.Date
  status      WorkerAvailabilityStatus
  note        String?
  changedById String?                  @map("changed_by_id")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  worker    User  @relation("WorkerScheduleWorker", fields: [workerId], references: [id])
  changedBy User? @relation("WorkerScheduleChangedBy", fields: [changedById], references: [id])

  @@unique([workerId, date])
  @@index([workerId])
  @@index([date])
  @@map("worker_schedules")
}

// A minimal, generic audit trail (no equivalent existed anywhere in this
// codebase before - the only prior precedent was an ad-hoc console.info
// line). `actorName` is duplicated onto the row (not just derived via the
// `actor` relation) so the log stays legible even if the acting user is
// later deleted; `actorId` is nullable to also represent system-generated
// actions (e.g. an automated status change), which must stay
// distinguishable from a human admin/worker action per the task's explicit
// requirement.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorName  String   @map("actor_name")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// PRD.md ยง11 lists Notification as a core entity; the example DBML in
// ARCHITECTURE.md ยง11 omits it. Added here to log FCM notifications sent to
// field officers for KTR violations (FR-10).
model Notification {
  id          String    @id @default(uuid())
  detectionId String    @map("detection_id")
  recipientId String    @map("recipient_id")
  title       String
  body        String
  sentAt      DateTime  @default(now()) @map("sent_at")
  readAt      DateTime? @map("read_at")

  detection SmokingDetection @relation(fields: [detectionId], references: [id])
  recipient User             @relation(fields: [recipientId], references: [id])

  @@map("notifications")
}

// ==========================================
// FACILITY / HOMESTAY CATALOG
// ==========================================

model Facility {
  id          String   @id @default(uuid())
  name        String
  description String?
  iconName    String?  @map("icon_name")
  // R2 public URL (public/facilities/... - see docs/STORAGE.md). Optional:
  // a facility can be represented by an icon, an image, or both.
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  homestays HomestayFacility[]

  @@map("facilities")
}

model Homestay {
  id            String    @id @default(uuid())
  name          String
  description   String?
  imageUrl      String?   @map("image_url")
  minCapacity   Int       @default(1) @map("min_capacity")
  maxCapacity   Int       @map("max_capacity")
  // Structured capacity info (section 28) - kept separate from the
  // "1 Bed"/"2 Bed"-style Facility tags, which remain purely decorative
  // amenity labels rather than the source of truth for room/bed counts.
  roomCount     Int       @default(1) @map("room_count")
  bedCount      Int       @default(1) @map("bed_count")
  weekdayPrice  BigInt    @map("weekday_price")
  weekendPrice  BigInt    @map("weekend_price")
  holidayPrice  BigInt    @map("holiday_price")
  extraBedPrice BigInt    @default(0) @map("extra_bed_price")
  maxExtraBeds  Int       @default(1) @map("max_extra_beds")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  facilities    HomestayFacility[]
  specialPrices HomestaySpecialPrice[]
  bookings      TransactionHomestay[]
  photos        FacilityPhoto[]

  @@map("homestays")
}

model HomestayFacility {
  homestayId          String  @map("homestay_id")
  facilityId          String  @map("facility_id")
  // Overrides Facility.description for this specific homestay (section 27)
  // - e.g. the generic "TV" facility becomes "Smart TV 43 inch dengan
  // Netflix" here without touching the shared Facility catalog row.
  descriptionOverride String? @map("description_override")
  quantity            Int?    @default(1)

  homestay Homestay @relation(fields: [homestayId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@id([homestayId, facilityId])
  @@map("homestay_facilities")
}

model HomestaySpecialPrice {
  id         String   @id @default(uuid())
  homestayId String   @map("homestay_id")
  date       DateTime @db.Date
  price      BigInt
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  homestay Homestay @relation(fields: [homestayId], references: [id])

  @@map("homestay_special_prices")
}

// Admin-managed calendar of holidays/closures (RULES.md ยง9 - business rule
// chosen: a Holiday date does two independent things, either of which the
// admin can opt into per date:
//   - isClosed: the date is unavailable for booking at all (e.g. facility
//     maintenance), enforced the same way as an existing conflicting
//     booking would be.
//   - pricing: for a non-closed holiday, every Homestay's already-existing
//     `holidayPrice` tier applies on that date instead of weekday/weekend
//     pricing (extends the existing 3-tier model rather than introducing a
//     second one). A `HomestaySpecialPrice` row for the same exact date, if
//     present, still wins over this - it's the most specific override.
//     Venues/edutrip currently have no weekend/holiday pricing tier of
//     their own (see ARCHITECTURE.md ยง11's DBML - they were never
//     specified with one), so a Holiday only affects their availability,
//     not their price.
model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @unique @db.Date
  name        String
  description String?
  isClosed    Boolean  @default(false) @map("is_closed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("holidays")
}

// Public gallery images (R2 object under public/, or a static /public path
// for seed/demo content - see docs/STORAGE.md). Exactly one of the FKs
// below is set per row.
model FacilityPhoto {
  id         String   @id @default(uuid())
  homestayId String?  @map("homestay_id")
  venueId    String?  @map("venue_id")
  url        String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  homestay Homestay? @relation(fields: [homestayId], references: [id])
  venue    Venue?    @relation(fields: [venueId], references: [id])

  @@map("facility_photos")
}

// ==========================================
// VENUE & EDUTRIP CATALOG
// ==========================================

model Venue {
  id           String    @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?   @map("image_url")
  minCapacity  Int       @default(1) @map("min_capacity")
  maxCapacity  Int       @map("max_capacity")
  pricePerHour BigInt    @map("price_per_hour")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  availableDays VenueAvailableDay[]
  bookings      TransactionVenue[]
  photos        FacilityPhoto[]

  @@map("venues")
}

model VenueAvailableDay {
  venueId String  @map("venue_id")
  day     DayType

  venue Venue @relation(fields: [venueId], references: [id])

  @@id([venueId, day])
  @@map("venue_available_days")
}

model EdutripPackage {
  id          String    @id @default(uuid())
  name        String
  pricePerPax BigInt    @map("price_per_pax")
  isPopular   Boolean   @default(false) @map("is_popular")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  activities EdutripPackageActivity[]
  bookings   TransactionEdutrip[]

  @@map("edutrip_packages")
}

model Activity {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  packages EdutripPackageActivity[]

  @@map("activities")
}

model EdutripPackageActivity {
  packageId           String  @map("package_id")
  activityId          String  @map("activity_id")
  // Overrides Activity.name's implicit "included item" description for this
  // specific package (section 27's override pattern, mirrored here for
  // EduTrip "included items" - section 29); reorderable per package.
  descriptionOverride String? @map("description_override")
  sortOrder           Int     @default(0) @map("sort_order")

  package  EdutripPackage @relation(fields: [packageId], references: [id])
  activity Activity       @relation(fields: [activityId], references: [id])

  @@id([packageId, activityId])
  @@map("edutrip_package_activities")
}

// ==========================================
// TRANSACTIONS & BOOKINGS
// ==========================================

model Transaction {
  id                    String        @id @default(uuid())
  invoiceNumber         String        @unique @map("invoice_number")
  customerName          String        @map("customer_name")
  customerEmail         String        @map("customer_email")
  customerPhone         String        @map("customer_phone")
  customerNote          String?       @map("customer_note")
  totalAmount           BigInt        @map("total_amount")
  snapUrl               String?       @map("snap_url")
  paymentMethod         String?       @map("payment_method")
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  paidAt                DateTime?     @map("paid_at")
  midtransTransactionId String?       @map("midtrans_transaction_id")
  // Running total of successfully confirmed refunds against this
  // transaction (section 12) - maintained transactionally alongside each
  // Refund row reaching SUCCESS, so refundableAmount = totalAmount -
  // refundedAmount never requires re-summing Refund history on every read.
  refundedAmount        BigInt        @default(0) @map("refunded_amount")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  homestays TransactionHomestay[]
  venues    TransactionVenue[]
  edutrips  TransactionEdutrip[]
  tickets   Ticket[]
  refunds   Refund[]

  @@index([createdAt])
  @@index([paymentStatus])
  @@map("transactions")
}

// A single Midtrans transaction can have multiple refunds against it
// (partial refunds), so this is its own table rather than scalar fields on
// Transaction. `refundKey` is the merchant-generated idempotency key sent
// to Midtrans's refund API - unique so the same logical refund attempt can
// be safely retried without Midtrans (or us) ever creating a duplicate.
model Refund {
  id                         String       @id @default(uuid())
  transactionId              String       @map("transaction_id")
  refundKey                  String       @unique @map("refund_key")
  midtransTransactionId      String?      @map("midtrans_transaction_id")
  amount                     BigInt
  reason                     String?
  status                     RefundStatus @default(PENDING)
  // Midtrans's own transaction_status string for this refund attempt
  // ("refund" / "partial_refund" / etc.) - kept separate from `status`
  // (our internal workflow state) so the two vocabularies are never
  // conflated.
  midtransStatus             String?      @map("midtrans_status")
  midtransRefundChargebackId String?      @map("midtrans_refund_chargeback_id")
  requestedByUserId          String       @map("requested_by_user_id")
  requestedAt                DateTime     @default(now()) @map("requested_at")
  confirmedAt                DateTime?    @map("confirmed_at")
  // Set only once Midtrans sends the later notification confirming the bank
  // has actually processed the refund (distinct from `confirmedAt`, which
  // marks when Midtrans first accepted the refund request) - see
  // lib/midtrans.ts's refund handling.
  bankConfirmedAt            DateTime?    @map("bank_confirmed_at")
  failureReason              String?      @map("failure_reason")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  requestedBy User        @relation(fields: [requestedByUserId], references: [id])

  @@index([transactionId])
  @@map("refunds")
}

model TransactionHomestay {
  id             String        @id @default(uuid())
  transactionId  String        @map("transaction_id")
  homestayId     String        @map("homestay_id")
  bookingStatus  BookingStatus @default(PENDING) @map("booking_status")
  checkInDate    DateTime      @map("check_in_date") @db.Date
  checkOutDate   DateTime      @map("check_out_date") @db.Date
  totalNights    Int           @map("total_nights")
  extraBedsCount Int           @default(0) @map("extra_beds_count")
  pricePerNight  BigInt        @map("price_per_night")
  extraBedPrice  BigInt        @default(0) @map("extra_bed_price")
  subtotal       BigInt
  createdAt      DateTime      @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  homestay    Homestay    @relation(fields: [homestayId], references: [id])
  ticket      Ticket?

  @@map("transaction_homestays")
}

model TransactionVenue {
  id            String        @id @default(uuid())
  transactionId String        @map("transaction_id")
  venueId       String        @map("venue_id")
  bookingStatus BookingStatus @default(PENDING) @map("booking_status")
  bookingDate   DateTime      @map("booking_date") @db.Date
  startTime     DateTime      @map("start_time") @db.Time
  endTime       DateTime      @map("end_time") @db.Time
  totalHours    Int           @map("total_hours")
  pricePerHour  BigInt        @map("price_per_hour")
  subtotal      BigInt
  createdAt     DateTime      @default(now()) @map("created_at")
  // When this booking actually transitioned CHECKED_IN -> COMPLETED (real
  // checkout time, not the originally scheduled endTime). Set exactly once,
  // atomically with that transition, in transitionBookingStatus
  // (src/features/bookings/service.ts). Lets venue availability release the
  // slot immediately on an early checkout instead of waiting for endTime -
  // see stillHoldsVenueSlot in src/features/booking/service.ts. Homestay has
  // no equivalent column; that availability rule is intentionally unchanged.
  checkedOutAt  DateTime?     @map("checked_out_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  venue       Venue       @relation(fields: [venueId], references: [id])
  ticket      Ticket?

  @@map("transaction_venues")
}

model TransactionEdutrip {
  id            String        @id @default(uuid())
  transactionId String        @map("transaction_id")
  packageId     String        @map("package_id")
  bookingStatus BookingStatus @default(PENDING) @map("booking_status")
  visitDate     DateTime      @map("visit_date") @db.Date
  paxCount      Int           @map("pax_count")
  pricePerPax   BigInt        @map("price_per_pax")
  subtotal      BigInt
  createdAt     DateTime      @default(now()) @map("created_at")

  transaction Transaction    @relation(fields: [transactionId], references: [id])
  package     EdutripPackage @relation(fields: [packageId], references: [id])
  ticket      Ticket?

  @@map("transaction_edutrips")
}

// One ticket per bookable line item (not per transaction/invoice), since
// each item can have its own valid date/time window and is checked in
// independently (PATTERNS.md ยง12 - QR Validation Pattern). `code` is a
// high-entropy opaque token - the QR encodes this, never the invoice
// number or any other guessable/trusted booking data.
model Ticket {
  id                String    @id @default(uuid())
  code              String    @unique
  transactionId     String    @map("transaction_id")
  homestayBookingId String?   @unique @map("homestay_booking_id")
  venueBookingId    String?   @unique @map("venue_booking_id")
  edutripBookingId  String?   @unique @map("edutrip_booking_id")
  validFrom         DateTime  @map("valid_from")
  validUntil        DateTime  @map("valid_until")
  usedAt            DateTime? @map("used_at")
  usedByUserId      String?   @map("used_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  transaction     Transaction          @relation(fields: [transactionId], references: [id])
  homestayBooking TransactionHomestay? @relation(fields: [homestayBookingId], references: [id])
  venueBooking    TransactionVenue?    @relation(fields: [venueBookingId], references: [id])
  edutripBooking  TransactionEdutrip?  @relation(fields: [edutripBookingId], references: [id])
  usedBy          User?                @relation("TicketVerifiedBy", fields: [usedByUserId], references: [id])

  @@map("tickets")
}
