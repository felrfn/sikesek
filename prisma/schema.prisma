// SIKESEK database schema
// Derived from the example DBML in .ai/ARCHITECTURE.md (section 11),
// with two naming decisions made explicit by the product owner:
// - role uses ADMIN / FIELD_OFFICER (RULES.md, PRD.md) instead of admin/employee
// - detection status uses DETECTED / NOTIFIED / RESOLVED (RULES.md, MEMORY.md)
//   instead of open/assigned/resolved/false_positive
// The exact schema may evolve as backend implementation proceeds (PRD.md ยง11).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  FIELD_OFFICER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

// CHECKED_IN is a distinct step from COMPLETED (the visitor has arrived and
// been ticket-validated, but the stay/visit itself may still be ongoing).
// REJECTED is an admin-initiated refusal, distinct from a CANCELLED booking
// (customer/system initiated, e.g. an expired payment).
enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  REJECTED
}

enum DayType {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DetectionStatus {
  DETECTED
  NOTIFIED
  RESOLVED
}

// Provenance of a KTR record. API is anything ingested through
// POST /api/ktr/detect (today: a manually-triggered fog-server call; later:
// an automated CCTV/YOLOv8 pipeline hitting the same endpoint - no schema
// change needed when that's wired up). MANUAL is an admin-created entry
// (e.g. backfilling an incident that a camera didn't catch).
enum DetectionSource {
  API
  MANUAL
}

// ==========================================
// USERS & KTR MONITORING
// ==========================================

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  username       String    @unique
  name           String
  hashedPassword String    @map("hashed_password")
  phone          String?
  role           Role      @default(FIELD_OFFICER)
  // R2 object key under private/ (see docs/STORAGE.md) - never a public URL.
  profileImageKey String?  @map("profile_image_key")

  createdAt      DateTime  @default(now()) @map("created_at")
  approvedAt     DateTime? @map("approved_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  fcmTokens         UserFcmToken[]
  assignedAreas     MonitoredArea[]     @relation("AreaAssignedEmployee")
  assignedDetections SmokingDetection[] @relation("DetectionAssignedTo")
  resolvedDetections SmokingDetection[] @relation("DetectionResolvedBy")
  notifications      Notification[]
  verifiedTickets    Ticket[]            @relation("TicketVerifiedBy")

  @@map("users")
}

model UserFcmToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String
  deviceInfo String?  @map("device_info")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_fcm_tokens")
}

model MonitoredArea {
  id                  String   @id @default(uuid())
  name                String
  locationDescription String?  @map("location_description")
  streamUrl           String   @map("stream_url")
  assignedEmployeeId  String?  @map("assigned_employee_id")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  assignedEmployee User?              @relation("AreaAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  detections       SmokingDetection[]

  @@map("monitored_areas")
}

model SmokingDetection {
  id          String          @id @default(uuid())
  areaId      String          @map("area_id")
  confidence  Decimal         @db.Decimal(5, 4)
  // R2 object key under private/ (see docs/STORAGE.md). Evidence is never
  // exposed via a public URL - the admin UI fetches a short-lived signed URL.
  evidenceKey String          @map("evidence_key")
  source      DetectionSource @default(API)
  status      DetectionStatus @default(DETECTED)
  assignedTo  String?         @map("assigned_to")
  detectedAt  DateTime        @map("detected_at")
  resolvedBy  String?         @map("resolved_by")
  resolvedAt  DateTime?       @map("resolved_at")
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  area                MonitoredArea @relation(fields: [areaId], references: [id])
  assignedToUser      User?         @relation("DetectionAssignedTo", fields: [assignedTo], references: [id])
  resolvedByUser      User?         @relation("DetectionResolvedBy", fields: [resolvedBy], references: [id])
  notifications       Notification[]

  @@map("smoking_detections")
}

// PRD.md ยง11 lists Notification as a core entity; the example DBML in
// ARCHITECTURE.md ยง11 omits it. Added here to log FCM notifications sent to
// field officers for KTR violations (FR-10).
model Notification {
  id            String    @id @default(uuid())
  detectionId   String    @map("detection_id")
  recipientId   String    @map("recipient_id")
  title         String
  body          String
  sentAt        DateTime  @default(now()) @map("sent_at")
  readAt        DateTime? @map("read_at")

  detection SmokingDetection @relation(fields: [detectionId], references: [id])
  recipient User             @relation(fields: [recipientId], references: [id])

  @@map("notifications")
}

// ==========================================
// FACILITY / HOMESTAY CATALOG
// ==========================================

model Facility {
  id        String   @id @default(uuid())
  name      String
  iconName  String   @map("icon_name")
  createdAt DateTime @default(now()) @map("created_at")

  homestays HomestayFacility[]

  @@map("facilities")
}

model Homestay {
  id             String   @id @default(uuid())
  name           String
  description    String?
  imageUrl       String?  @map("image_url")
  minCapacity    Int      @default(1) @map("min_capacity")
  maxCapacity    Int      @map("max_capacity")
  weekdayPrice   BigInt   @map("weekday_price")
  weekendPrice   BigInt   @map("weekend_price")
  holidayPrice   BigInt   @map("holiday_price")
  extraBedPrice  BigInt   @default(0) @map("extra_bed_price")
  maxExtraBeds   Int      @default(1) @map("max_extra_beds")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  facilities     HomestayFacility[]
  specialPrices  HomestaySpecialPrice[]
  bookings       TransactionHomestay[]
  photos         FacilityPhoto[]

  @@map("homestays")
}

model HomestayFacility {
  homestayId String @map("homestay_id")
  facilityId String @map("facility_id")

  homestay Homestay @relation(fields: [homestayId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])

  @@id([homestayId, facilityId])
  @@map("homestay_facilities")
}

model HomestaySpecialPrice {
  id         String   @id @default(uuid())
  homestayId String   @map("homestay_id")
  date       DateTime @db.Date
  price      BigInt
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  homestay Homestay @relation(fields: [homestayId], references: [id])

  @@map("homestay_special_prices")
}

// Public gallery images (R2 object under public/, or a static /public path
// for seed/demo content - see docs/STORAGE.md). Exactly one of the FKs
// below is set per row.
model FacilityPhoto {
  id         String   @id @default(uuid())
  homestayId String?  @map("homestay_id")
  venueId    String?  @map("venue_id")
  url        String
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  homestay Homestay? @relation(fields: [homestayId], references: [id])
  venue    Venue?    @relation(fields: [venueId], references: [id])

  @@map("facility_photos")
}

// ==========================================
// VENUE & EDUTRIP CATALOG
// ==========================================

model Venue {
  id           String    @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?   @map("image_url")
  minCapacity  Int       @default(1) @map("min_capacity")
  maxCapacity  Int       @map("max_capacity")
  pricePerHour BigInt    @map("price_per_hour")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  availableDays VenueAvailableDay[]
  bookings      TransactionVenue[]
  photos        FacilityPhoto[]

  @@map("venues")
}

model VenueAvailableDay {
  venueId String  @map("venue_id")
  day     DayType

  venue Venue @relation(fields: [venueId], references: [id])

  @@id([venueId, day])
  @@map("venue_available_days")
}

model EdutripPackage {
  id           String    @id @default(uuid())
  name         String
  pricePerPax  BigInt    @map("price_per_pax")
  isPopular    Boolean   @default(false) @map("is_popular")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  activities EdutripPackageActivity[]
  bookings   TransactionEdutrip[]

  @@map("edutrip_packages")
}

model Activity {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  packages EdutripPackageActivity[]

  @@map("activities")
}

model EdutripPackageActivity {
  packageId  String @map("package_id")
  activityId String @map("activity_id")

  package  EdutripPackage @relation(fields: [packageId], references: [id])
  activity Activity       @relation(fields: [activityId], references: [id])

  @@id([packageId, activityId])
  @@map("edutrip_package_activities")
}

// ==========================================
// TRANSACTIONS & BOOKINGS
// ==========================================

model Transaction {
  id                    String        @id @default(uuid())
  invoiceNumber         String        @unique @map("invoice_number")
  customerName          String        @map("customer_name")
  customerEmail         String        @map("customer_email")
  customerPhone         String        @map("customer_phone")
  customerNote          String?       @map("customer_note")
  totalAmount           BigInt        @map("total_amount")
  snapUrl               String?       @map("snap_url")
  paymentMethod         String?       @map("payment_method")
  paymentStatus         PaymentStatus @default(PENDING) @map("payment_status")
  paidAt                DateTime?     @map("paid_at")
  midtransTransactionId String?       @map("midtrans_transaction_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  homestays TransactionHomestay[]
  venues    TransactionVenue[]
  edutrips  TransactionEdutrip[]
  tickets   Ticket[]

  @@map("transactions")
}

model TransactionHomestay {
  id              String        @id @default(uuid())
  transactionId   String        @map("transaction_id")
  homestayId      String        @map("homestay_id")
  bookingStatus   BookingStatus @default(PENDING) @map("booking_status")
  checkInDate     DateTime      @db.Date @map("check_in_date")
  checkOutDate    DateTime      @db.Date @map("check_out_date")
  totalNights     Int           @map("total_nights")
  extraBedsCount  Int           @default(0) @map("extra_beds_count")
  pricePerNight   BigInt        @map("price_per_night")
  extraBedPrice   BigInt        @default(0) @map("extra_bed_price")
  subtotal        BigInt
  createdAt       DateTime      @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  homestay    Homestay    @relation(fields: [homestayId], references: [id])
  ticket      Ticket?

  @@map("transaction_homestays")
}

model TransactionVenue {
  id            String        @id @default(uuid())
  transactionId String        @map("transaction_id")
  venueId       String        @map("venue_id")
  bookingStatus BookingStatus @default(PENDING) @map("booking_status")
  bookingDate   DateTime      @db.Date @map("booking_date")
  startTime     DateTime      @db.Time @map("start_time")
  endTime       DateTime      @db.Time @map("end_time")
  totalHours    Int           @map("total_hours")
  pricePerHour  BigInt        @map("price_per_hour")
  subtotal      BigInt
  createdAt     DateTime      @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])
  venue       Venue       @relation(fields: [venueId], references: [id])
  ticket      Ticket?

  @@map("transaction_venues")
}

model TransactionEdutrip {
  id            String        @id @default(uuid())
  transactionId String        @map("transaction_id")
  packageId     String        @map("package_id")
  bookingStatus BookingStatus @default(PENDING) @map("booking_status")
  visitDate     DateTime      @db.Date @map("visit_date")
  paxCount      Int           @map("pax_count")
  pricePerPax   BigInt        @map("price_per_pax")
  subtotal      BigInt
  createdAt     DateTime      @default(now()) @map("created_at")

  transaction Transaction    @relation(fields: [transactionId], references: [id])
  package     EdutripPackage @relation(fields: [packageId], references: [id])
  ticket      Ticket?

  @@map("transaction_edutrips")
}

// One ticket per bookable line item (not per transaction/invoice), since
// each item can have its own valid date/time window and is checked in
// independently (PATTERNS.md ยง12 - QR Validation Pattern). `code` is a
// high-entropy opaque token - the QR encodes this, never the invoice
// number or any other guessable/trusted booking data.
model Ticket {
  id                String    @id @default(uuid())
  code              String    @unique
  transactionId     String    @map("transaction_id")
  homestayBookingId String?   @unique @map("homestay_booking_id")
  venueBookingId    String?   @unique @map("venue_booking_id")
  edutripBookingId  String?   @unique @map("edutrip_booking_id")
  validFrom         DateTime  @map("valid_from")
  validUntil        DateTime  @map("valid_until")
  usedAt            DateTime? @map("used_at")
  usedByUserId      String?   @map("used_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  transaction     Transaction           @relation(fields: [transactionId], references: [id])
  homestayBooking TransactionHomestay?  @relation(fields: [homestayBookingId], references: [id])
  venueBooking    TransactionVenue?     @relation(fields: [venueBookingId], references: [id])
  edutripBooking  TransactionEdutrip?   @relation(fields: [edutripBookingId], references: [id])
  usedBy          User?                 @relation("TicketVerifiedBy", fields: [usedByUserId], references: [id])

  @@map("tickets")
}
